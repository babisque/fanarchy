[Unit]
Description=Fanarchy fan control daemon
Documentation=https://github.com/babisque/fanarchy
After=systemd-modules-load.service

[Service]
Type=simple
ExecStart=/usr/bin/fanarchyd run
# Runs after every stop, including SIGKILL and OOM kills: hands every
# controlled fan back to the BIOS. Pumps are never touched.
ExecStopPost=/usr/bin/fanarchyd restore
Restart=on-failure
RestartSec=2

# Hardening
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
ReadWritePaths=/sys/class/hwmon /etc/fanarchy /run

[Install]
WantedBy=multi-user.target
