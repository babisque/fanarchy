# Nothing is enabled or started here: configure first, then enable.

post_install() {
  cat <<'MSG'
==> Fanarchy is installed but not running. Next steps:
    1. sudo fanarchyctl init        (writes /etc/fanarchy/config.json, controls nothing yet)
    2. Edit the config: mark the pump first ("role": "pump"), then add fans.
    3. sudo usermod -aG fanarchy "$USER"   (log out and back in)
    4. sudo systemctl enable --now fanarchyd
    5. omarchy plugin add https://github.com/babisque/fanarchy --enable
==> Gigabyte boards with ITE chips may need the community it87 driver.
    See "Known issues" in /usr/share/doc/fanarchy/README.md.
MSG
}

post_upgrade() {
  if systemctl is-active --quiet fanarchyd.service; then
    echo "==> Restart the daemon to use the new version: sudo systemctl restart fanarchyd"
  fi
}
